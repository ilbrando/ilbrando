    "@vitejs/plugin-react": "~6.0.1",
    "eslint": "~10.2.1",
    "npm-run-all": "~4.1.5",
    "typescript": "~6.0.3",
    "vite": "~8.0.10",
    "tsdown": "~0.21.10"
  },
  "dependencies": {
    "@ilbrando/utils": "workspace:*",
