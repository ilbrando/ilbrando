{
  "name": "@ilbrando/eslint-plugin",
  "version": "1.0.7",
  "description": "ES lint rules",
  "license": "MIT",
  "author": {
    "name": "ilbrando"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ilbrando/ilbrando.git",
    "directory": "tools/eslint-plugin"
  },
  "homepage": "https://github.com/ilbrando/ilbrando",
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "run-p vite type-check",
    "vite": "vite",
    "type-check": "tsc --noEmit --watch",
    "build": "tsdown"
  },
  "dependencies": {
    "@types/eslint__js": "~8.42.3",
    "@typescript-eslint/scope-manager": "~8.46.3",
    "@typescript-eslint/visitor-keys": "~8.46.3",
    "@typescript-eslint/types": "~8",
    "@typescript-eslint/utils": "~8.46.3",
    "@typescript-eslint/parser": "~8.46.3",
    "@types/eslint-config-prettier": "~6.11.3",
    "@eslint/js": "~9.2.0"
  },
  "devDependencies": {
    "@types/node": "~20.12.12",
    "eslint-config-prettier": "~9.1.0",
    "typescript": "~5.9",
    "vite": "~8.0.10",
    "vitest": "~4.1.5",
    "tsdown": "~0.21.10"
  },
  "peerDependencies": {
    "@typescript-eslint/eslint-plugin": "^8"
  },
  "inlinedDependencies": {
    "eslint-config-prettier": "9.1.2"
  }
}
