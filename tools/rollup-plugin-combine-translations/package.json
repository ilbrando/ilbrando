{
  "name": "@ilbrando/rollup-plugin-combine-translations",
  "description": "Rollup/Vite plugin that combines translations declared next to the code into one i18next resource object.",
  "version": "2.0.1",
  "license": "MIT",
  "author": {
    "name": "ilbrando"
  },
  "keywords": [
    "rollup-plugin",
    "vite-plugin",
    "i18n",
    "i18next"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ilbrando/ilbrando.git",
    "directory": "tools/rollup-plugin-combine-translations"
  },
  "homepage": "https://github.com/ilbrando/ilbrando",
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "test": "tsc --noEmit && vitest run",
    "eslint": "eslint --max-warnings=0"
  },
  "dependencies": {
    "@ilbrando/utils": "workspace:*",
    "@typescript-eslint/typescript-estree": "~8.59.1"
  },
  "devDependencies": {
    "@ilbrando/eslint-plugin": "workspace:*",
    "eslint": "~10.2.1",
    "@types/node": "^24",
    "rollup": "~4.53.1",
    "typescript": "~6.0.3",
    "vite": "~8.0.10",
    "vitest": "~4.1.5",
    "tsdown": "~0.21.10"
  }
}
